{
  "name": "instagram-scraper-bot",
  "version": "1.0.0",
  "description": "Instagram Scraper Bot module for Telegram bot",
  "type": "module",
  "scripts": {
    "dev": "node --import tsx/esm src/bot.ts",
    "start": "node --import tsx/esm src/bot.ts",
    "build": "tsc --noEmit && echo 'Build completed'",
    "refresh:viral": "node --import tsx/esm src/scripts/refresh-strategy.ts viral",
    "refresh:full": "node --import tsx/esm src/scripts/refresh-strategy.ts",
    "diagnose:openai": "node --import tsx/esm scripts/test-openai-setup.ts",
    "test:complete": "node --import tsx/esm scripts/one-reel-complete-test.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "typecheck": "tsc --noEmit --skipLibCheck",
    "typecheck:full": "tsc --noEmit",
    "db:studio": "npx drizzle-kit studio --port 3457",
    "db:generate": "npx drizzle-kit generate",
    "db:push": "npx drizzle-kit push",
    "db:migrate": "npx drizzle-kit migrate",
    "meta-muse:init": "node --import tsx/esm src/scripts/meta-muse-init-project.ts",
    "meta-muse:scrape": "node --import tsx/esm src/scripts/meta-muse-robust-cycle.ts",
    "meta-muse:check": "node --import tsx/esm src/scripts/meta-muse-check-data.ts",
    "meta-muse:demo": "node --import tsx/esm src/scripts/meta-muse-demo-cycle.ts",
    "meta-muse:quick-test": "node --import tsx/esm src/scripts/meta-muse-quick-test.ts",
    "meta-muse:daily": "node --import tsx/esm src/scripts/meta-muse-daily-runner.ts",
    "sync-obsidian": "node --import tsx/esm src/scripts/sync-obsidian-vault.ts",
    "update-live-data": "node --import tsx/esm src/scripts/update-live-data.ts",
    "strategy": "node --import tsx/esm src/scripts/strategy-manager.ts",
    "strategy:clients": "npm run strategy clients",
    "strategy:switch": "npm run strategy switch",
    "strategy:run": "npm run strategy run",
    "strategy:run-all": "npm run strategy run-all",
    "railway:check": "node scripts/check-railway-readiness.js",
    "railway:setup": "bash scripts/setup-railway.sh",
    "railway:deploy": "railway up",
    "railway:logs": "railway logs --tail 100"
  },
  "keywords": [
    "instagram",
    "scraper",
    "telegram",
    "bot"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@neondatabase/serverless": "^1.0.0",
    "@notionhq/client": "^3.0.1",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express-rate-limit": "^6.0.2",
    "@types/helmet": "^4.0.0",
    "apify-client": "^2.12.3",
    "assemblyai": "^4.12.2",
    "axios": "^1.9.0",
    "better-sqlite3": "^11.10.0",
    "compression": "^1.8.0",
    "cors": "^2.8.5",
    "date-fns": "^4.1.0",
    "dotenv": "^16.5.0",
    "drizzle-kit": "^0.31.1",
    "drizzle-orm": "^0.43.1",
    "ejs": "^3.1.10",
    "exceljs": "^4.4.0",
    "express": "^5.1.0",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.1.0",
    "open": "^10.1.2",
    "openai": "^4.102.0",
    "pg": "^8.15.6",
    "telegraf": "^4.16.3",
    "uuid": "^11.1.0",
    "ws": "^8.18.2",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^5.0.1",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.5.4",
    "@types/supertest": "^6.0.3",
    "@vercel/node": "^5.2.0",
    "ai": "^4.3.16",
    "dotenv-cli": "^8.0.0",
    "input": "^1.0.1",
    "jest": "^29.7.0",
    "supertest": "^7.0.0",
    "telegram": "^2.19.10",
    "ts-jest": "^29.2.5",
    "tsx": "^4.19.4",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
